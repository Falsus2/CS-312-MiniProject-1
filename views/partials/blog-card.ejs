<div class="col">
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="card-title"><%= post.title %></h5>
                <small class="text-body-secondary"><%= post.author %></small>
            </div>
            <p class="card-text">
                <%= post.content %>
            </p>
            <div class="d-flex justify-content-between align-items-center">
                <div class="btn-group">
                    <a href="/edit-post/<%= index %>" class="btn btn-sm btn-outline-primary">Edit</a>
                    <form action="/delete-post/<%= index %>" method="POST" style="display: inline;">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            Delete
                        </button>
                    </form>
                </div>
                <small class="text-body-secondary"><%= post.date %></small>
            </div>
        </div>
    </div>
</div>