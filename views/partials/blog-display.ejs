<div class="album py-5 bg-body-tertiary">
    <div class="container">
        <% if (blogPosts.length > 0) { %>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
            <% blogPosts.forEach((post, index)=> { %>
                <%- include ("blog-card.ejs", { post: post, index: index }) %>
            <% }) %>
            </div>
        <% } else { %>
            <p class="text-center text-muted">No blog posts yet. Be the first to create one!</p>
        <% } %>
    </div>
</div> 