<!doctype html>
<html lang="en" data-bs-theme="auto">
  <%- include ("partials/header.ejs") %>
  <body>
    <%- include ("partials/theme-toggle.ejs") %>
    <%- include ("partials/navbar.ejs") %>
    <main>
      <section class="text-center container">
        <div class="row py-lg-5">
          <div class="col-lg-6 col-md-8 mx-auto">
            <h1 class="fw-light">Edit Post</h1>
              <form action="/edit-post/<%= index %>" method="POST">
                <div class="row">
                    <div class="col">
                        <label for="title">Title</label>
                        <input type="text" class="form-control" name="title" value="<%= blogPosts[index].title %>" required>
                    </div>
                    <div class="col">
                        <label for="author">Author</label>
                        <input type="text" class="form-control" name="author" value="<%= blogPosts[index].author %>" required>
                    </div>
                </div>
                <div class="form-group">
                    <label for="content">Content</label>
                    <textarea class="form-control" name="content" id="content" rows="5" required><%= blogPosts[index].content %></textarea>
                </div>
                <button type="submit" class="btn btn-primary mt-3">Edit Post</button>
              </form>
          </div>
        </div>
      </section>
      <%- include ("partials/blog-display.ejs") %>
    </main>
    <%- include ("partials/footer.ejs") %>
  </body>
</html>